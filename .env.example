NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Usuario administrador creado por el seed
ADMIN_EMAIL=admin@sonagt.test
ADMIN_PASSWORD=

# Orígenes que pueden llamar a la API desde un navegador (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Intentos de login permitidos por IP cada 15 minutos (opcional, por defecto 5)
LOGIN_RATE_LIMIT_MAX=5
